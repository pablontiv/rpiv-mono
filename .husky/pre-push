#!/bin/sh

# git exports GIT_DIR (and friends) to hooks; from a linked worktree it points at
# the worktree gitdir, so git-fixture tests would run against the real repo.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY

echo "Running test suite with coverage before push..."
npm run coverage
if [ $? -ne 0 ]; then
  echo "Tests or coverage thresholds failed. Push aborted."
  exit 1
fi

echo "Tests + coverage passed."
